# wecom-aibot-kb 配置文件模板
# 复制本文件为 config.yaml 后按需修改；真实 config.yaml 已被 gitignore，禁止提交
# 密钥类配置建议使用环境变量 WECOM_BOT_ID / WECOM_BOT_SECRET，优先级高于本文件

# 企微智能机器人接入
wecom:
  bot_id: ""          # 智能机器人 BotID（建议用环境变量 WECOM_BOT_ID 注入）
  bot_secret: ""      # 智能机器人 Secret（建议用环境变量 WECOM_BOT_SECRET 注入）
  ws_url: "wss://openws.work.weixin.qq.com"  # 长连接 WebSocket 地址（官方固定）
  heartbeat_seconds: 30   # 心跳间隔（秒）
  reconnect_max_seconds: 30  # 断线重连退避封顶（秒）
  dedup_cache_size: 10000    # msgid 去重缓存上限

# 回复设置
reply:
  prefix: "[AI自动回复]："                     # 每条回复前拼接的前缀
  no_answer: "抱歉，暂时没有找到相关答案，已记录您的问题，管理员会尽快补充。"  # 无结果话术

# 群聊聚合引擎
aggregate:
  window_seconds: 30  # 多消息聚合时间窗（秒）
  max_queue: 3        # 单个用户与机器人同时交互的消息数上限（企微硬限制为 3）
  mention_targets: [] # @ 目标列表（机器人名称/aibotid），为空时回退到机器人名

# 检索应答引擎
retriever:
  score_threshold: 0.3  # 检索置信度阈值，低于视为无结果
  top_k: 5              # 返回候选条数

# 知识入库流水线
kb:
  repo_url: ""                    # Git 仓库地址，为空则用 repo_path 本地目录
  repo_branch: "main"             # 同步分支
  repo_path: ""                   # 本地 MD 文档目录（repo_url 为空时使用）
  work_dir: "data/kb_repo"        # 仓库克隆/工作目录
  chunk_size: 500                 # 切分片段字符数
  chunk_overlap: 50               # 片段尾部重叠字符数
  include_patterns: ["*.md"]      # 入库文件匹配模式
  exclude_patterns: ["README.md"] # 排除文件

# 本地存储
storage:
  db_path: "data/kb.db"   # SQLite 数据库文件路径
  log_dir: "logs"         # 日志目录

# Web 服务
web:
  host: "0.0.0.0"
  port: 8080
